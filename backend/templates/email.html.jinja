<html>
<body>
<h2>Road Cameras</h2>
<table border='1' cellpadding='8' cellspacing='0'>
<tr><th>Name</th><th>Image</th></tr>
{%- for result in results %}
<tr>
<td>{{ result.name }}</td>
{%- if result.error %}
<td>Error</td>
{%- else %}
<td><img src='cid:camera_{{ result.id }}' width='320'></td>
{%- endif %}
</tr>
{%- endfor %}
</table>
</body>
</html>
